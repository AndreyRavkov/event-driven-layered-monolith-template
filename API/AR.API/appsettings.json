{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // to see full logs in JSON format, uncomment line below
          // "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          // macOS
          "path": "~/logs/AR/Debug/log-.txt",
          // Win
          // "path": "c:\\logs\\AR\\log-.txt"
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithThreadId", "WithThreadName"],
    "Properties": {
      "Application": "API"
    }
  },
  "CorsSettings": {
    "Origins": "https://localhost:8080;http://localhost:8080",
    "Methods": "GET;POST;PUT;PATCH;DELETE;OPTIONS"
  },
  "DataBaseSettings": {
    "MainDb": "Data Source=../../DB.sqlite"
  },
  "AppSettings": {
    "MaxRequestBodySizeBytes": 524288000
  },
  "JwtSettings": {
    "Issuer": "AR API",
    "ExpireMinutes": "30",
    "Secret": "wKzsQirtutp4jQJJ3kVzgvqWue3cDPXMAiwiubjBerQPQLXijTGMPx246LN98A4B"
  }
}
